@page "/"                               
@using sqliteOrnekProje.Models
@using sqliteOrnekProje.Services
@inject DatabaseService DbService
<!-- Üstte ilk satırda bu sayfanın adresini ve bağımlılıkları belirledik
   inject DatabaseService DbService satırı MauiProgram.cs içinde kaydettiğimiz servisi sayfada kullanılabilir hale getirir.
-->
<h3 class="mb-4 text-center">Personel Temel Bilgi Yönetimi</h3>

<!-- KAYIT / DÜZENLEME FORMU -->
<!--@bind="yeniKisi.Tc" kodu HTML giriş kutusu (input) ile C# değişkenini birbirine bağlar. Kutudaki metin değiştiğinde C# değişkeni anında güncellenir.-->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0">Personel Kayıt Formu</h5>
    </div>
    <div class="card-body">
        <EditForm Model="@yeniKisi" OnValidSubmit="@Kaydet">
            <!--Form gönderildiğinde (submit butonuna basıldığında) C# tarafındaki Kaydet metodunu tetikler.-->
            
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">TC Kimlik No:</label>
                    <input class="form-control" @bind="yeniKisi.Tc" placeholder="TC Giriniz" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ad:</label>
                    <input class="form-control" @bind="yeniKisi.Ad" placeholder="Ad Giriniz" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Soyad:</label>
                    <input class="form-control" @bind="yeniKisi.Soyad" placeholder="Soyad Giriniz" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Eğitim Durumu:</label>
                    <input class="form-control" @bind="yeniKisi.EgitimDurumu" placeholder="Eğitim Durumu" required />
                </div>
            </div>

            <div class="mt-3 text-end">
                <button type="submit" class="btn btn-success">Kaydet / Güncelle</button>
                <button type="button" class="btn btn-secondary ms-2" @onclick="FormuTemizle">Temizle</button>
            </div>
        </EditForm>
    </div>
</div>

<!-- PERSONEL LİSTESİ TABLOSU -->
<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
        <h5 class="card-title mb-0">Kaydolmuş Personeller</h5>
    </div>
    <div class="card-body">
        @if (personelListesi == null)
        {
            <p><em>Veriler yükleniyor...</em></p>
        }
        else if (!personelListesi.Any())
        {
            <div class="alert alert-warning mb-0">Henüz kaydedilmiş veri bulunmamaktadır.</div>
        }
        else
        {
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>TC</th>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Eğitim Durumu</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kisi in personelListesi)
                    {
                        <tr>
                            <td>@kisi.Tc</td>
                            <td>@kisi.Ad</td>
                            <td>@kisi.Soyad</td>
                            <td>@kisi.EgitimDurumu</td>
                            <td>
                                <button class="btn btn-sm btn-info me-1" @onclick="() => DuzenleSec(kisi)">Düzenle</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Sil(kisi)">Sil</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<TemelBilgi> personelListesi = new();
    private TemelBilgi yeniKisi = new();

    // Sayfa ilk yüklendiğinde veritabanından listeyi çekiyoruz
    protected override async Task OnInitializedAsync()     //Blazor sayfasının yaşam döngüsü metodudur. Sayfa ekrana gelmeden hemen önce çalışır ve verileri veritabanından yüklemek (ListeyiYukle) için kullanılır.
    {
        await ListeyiYukle();
    }

    private async Task ListeyiYukle()
    {
        personelListesi = await DbService.GetAllAsync();
    }

    private async Task Kaydet()
    {
        if (!string.IsNullOrWhiteSpace(yeniKisi.Tc))
        {
            await DbService.SaveAsync(yeniKisi);
            FormuTemizle();
            await ListeyiYukle();
        }
    }

    private async Task Sil(TemelBilgi kisi)
    {
        await DbService.DeleteAsync(kisi);
        await ListeyiYukle();
    }

    private void DuzenleSec(TemelBilgi kisi)
    {
        // Seçilen kişiyi form alanlarına dolduruyoruz
        yeniKisi = new TemelBilgi
        {
            Tc = kisi.Tc,
            Ad = kisi.Ad,
            Soyad = kisi.Soyad,
            EgitimDurumu = kisi.EgitimDurumu
        };
    }

    private void FormuTemizle()
    {
        yeniKisi = new TemelBilgi();
    }
}