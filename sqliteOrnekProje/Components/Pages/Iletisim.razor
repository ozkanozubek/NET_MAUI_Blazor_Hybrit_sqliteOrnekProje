@page "/iletisim"
@using sqliteOrnekProje.Models
@using sqliteOrnekProje.Services
@inject DatabaseService DbService
@inject IletisimService IletisimService

<h3 class="mb-4 text-center">Personel İletişim Bilgileri Yönetimi</h3>

<div class="row">
    <!-- 1. PERSONEL ARAMA ALANI -->
    <div class="col-md-12 mb-4">
        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">1. Personel Ara (TC Kimlik No ile)</h5>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-6">
                        <input class="form-control" @bind="arananTc" placeholder="TC Kimlik No Giriniz..." />
                    </div>
                    <div class="col-md-6">
                        <button class="btn btn-primary me-2" @onclick="PersonelAra">Ara</button>
                        <button class="btn btn-secondary" @onclick="AramayiTemizle">Temizle</button>
                    </div>
                </div>

                <!-- ARAMA SONUCU BİLGİLENDİRMESİ -->
                @if (seciliPersonel != null)
                {
                    <div class="alert alert-success mt-3 mb-0">
                        <strong>Seçili Personel:</strong> @seciliPersonel.Ad @seciliPersonel.Soyad (TC: @seciliPersonel.Tc)
                    </div>
                }
                else if (aramaYapildi)
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        Girdiğiniz TC Kimlik No ile eşleşen personel bulunamadı.
                    </div>
                }
            </div>
        </div>
    </div>

    @if (seciliPersonel != null)
    {
        <!-- 2. İLETİŞİM BİLGİSİ EKLEME / DÜZENLEME FORMU -->
        <div class="col-md-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">2. İletişim Bilgisi Ekle / Düzenle</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="@yeniIletisim" OnValidSubmit="@Kaydet">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">GSM No <span class="text-danger">*</span></label>
                                <input class="form-control" @bind="yeniIletisim.GsmNo" placeholder="05xx..." required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">İş Tel (İsteğe Bağlı)</label>
                                <input class="form-control" @bind="yeniIletisim.IsTel" placeholder="02xx..." />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">E-Posta <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" @bind="yeniIletisim.Eposta" placeholder="ornek@email.com" required />
                            </div>
                        </div>

                        <div class="mt-3 text-end">
                            <button type="submit" class="btn btn-success">Kaydet</button>
                            <button type="button" class="btn btn-secondary ms-2" @onclick="FormuTemizle">Temizle</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- 3. SEÇİLİ PERSONELİN İLETİŞİM BİLGİLERİ LİSTESİ -->
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="card-title mb-0">3. Kayıtlı İletişim Bilgileri</h5>
                </div>
                <div class="card-body">
                    @if (!iletisimListesi.Any())
                    {
                        <div class="alert alert-info mb-0">Bu personele ait henüz iletişim bilgisi eklenmemiş.</div>
                    }
                    else
                    {
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>GSM No</th>
                                    <th>İş Tel</th>
                                    <th>E-Posta</th>
                                    <th style="width: 150px;">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in iletisimListesi)
                                {
                                    <tr>
                                        <td>@item.GsmNo</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.IsTel) ? "-" : item.IsTel)</td>
                                        <td>@item.Eposta</td>
                                        <td>
                                            <button class="btn btn-sm btn-info me-1" @onclick="() => Duzenle(item)">Düzenle</button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => Sil(item)">Sil</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string arananTc = string.Empty;
    private TemelBilgi? seciliPersonel;
    private bool aramaYapildi = false;

    private List<IletisimBilgisi> iletisimListesi = new();
    private IletisimBilgisi yeniIletisim = new();

    private async Task PersonelAra()
    {
        aramaYapildi = false;
        seciliPersonel = null;

        if (!string.IsNullOrWhiteSpace(arananTc))
        {
            seciliPersonel = await DbService.GetByTcAsync(arananTc.Trim());
            aramaYapildi = true;

            if (seciliPersonel != null)
            {
                await IletisimListesiniYukle();
            }
        }
    }

    private void AramayiTemizle()
    {
        arananTc = string.Empty;
        seciliPersonel = null;
        aramaYapildi = false;
        iletisimListesi.Clear();
        FormuTemizle();
    }

    private async Task IletisimListesiniYukle()
    {
        if (seciliPersonel != null)
        {
            iletisimListesi = await IletisimService.GetIletisimListByTcAsync(seciliPersonel.Tc);
        }
    }

    private async Task Kaydet()
    {
        if (seciliPersonel != null)
        {
            yeniIletisim.Tc = seciliPersonel.Tc;
            await IletisimService.SaveIletisimAsync(yeniIletisim);
            FormuTemizle();
            await IletisimListesiniYukle();
        }
    }

    private async Task Sil(IletisimBilgisi item)
    {
        await IletisimService.DeleteIletisimAsync(item);
        await IletisimListesiniYukle();
    }

    private void Duzenle(IletisimBilgisi item)
    {
        yeniIletisim = new IletisimBilgisi
        {
            Id = item.Id,
            Tc = item.Tc,
            GsmNo = item.GsmNo,
            IsTel = item.IsTel,
            Eposta = item.Eposta
        };
    }

    private void FormuTemizle()
    {
        yeniIletisim = new IletisimBilgisi();
    }
}